REACHPRO_COOKIE=
ACTIVE_ACCOUNT_ID=7a13a9c9-4ef4-492e-9eb0-19adcfa79da3
DATABASE_PATH=./scarcity.db
NOTION_API_KEY=
NOTION_STALL_RENTS_DATABASE_ID=
TEAMS_WEBHOOK_URL=
EVENTS_TEAMS_WEBHOOK_URL=
FACILITY_SCAN_INTERVAL_HOURS=1
EVENTS_SCAN_INTERVAL_HOURS=1
LYSTED_TEAMS_WEBHOOK_URL=
# ReachPro sold-out alerts. Leave blank on a laptop: scans still run and
# decide, they just post nothing.
REACHPRO_TEAMS_WEBHOOK_URL=
LYSTED_SCAN_INTERVAL_HOURS=3
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_REPORT_SITE_HOST=yourspotrented.sharepoint.com
SHAREPOINT_REPORT_SITE_PATH=/sites/MaxParkArbLLC
SHAREPOINT_REPORT_FOLDER_PATH=Stubhub Team/Pricing_Alerts
# Bearer token for api.lysted.com. Blank = CSV upload only. A browser session
# token expires after 24h; ask Lysted for an API key for unattended syncing.
LYSTED_API_TOKEN=

# Lysted Deactivation Alerts group chat — posts only the listings taken off sale
DEACTIVATION_TEAMS_WEBHOOK_URL=

# Bearer token for portal.stagefront.com. A browser session token, good for
# about a day — paste a fresh one on the dashboard instead of editing this.
STAGEFRONT_API_TOKEN=
# Optional — defaults to "MaxParkArbLLC (Max Lawrence)" if unset.
STAGEFRONT_COMPANY_NAME=
STAGEFRONT_TEAMS_WEBHOOK_URL=
STAGEFRONT_SCAN_INTERVAL_HOURS=3

# Deactivation ("Unshare Everywhere") — off by default, same as
# LYSTED_ALLOW_WRITES / REACHPRO_ALLOW_WRITES. With this unset, deactivation
# decisions are still made and shown (dry-run) but nothing is sent.
STAGEFRONT_ALLOW_WRITES=
# Its own group — separate from the shared DEACTIVATION_TEAMS_WEBHOOK_URL
# that Lysted/ReachPro post deactivation confirmations to.
STAGEFRONT_DEACTIVATION_TEAMS_WEBHOOK_URL=
